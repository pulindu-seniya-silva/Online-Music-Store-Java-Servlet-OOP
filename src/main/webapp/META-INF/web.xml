<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Music Pulse</display-name>
    
    <servlet>
    	<servlet-name>Product</servlet-name>
    	<servlet-class>com.music.servlets.ProductServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
    	<servlet-name>Product</servlet-name>
  		<url-pattern>/product/*</url-pattern>
    </servlet-mapping>
	
	<servlet>
    	<servlet-name>AdminItems</servlet-name>
    	<servlet-class>com.music.servlets.AdminItemServlet</servlet-class>
    </servlet>
    
	<servlet-mapping>
		<servlet-name>AdminItems</servlet-name>
		<url-pattern>/admin/items</url-pattern>
	</servlet-mapping>
	
	<servlet>
    	<servlet-name>AdminItemView</servlet-name>
    	<servlet-class>com.music.servlets.AdminItemViewServlet</servlet-class>
    </servlet>
    
	<servlet-mapping>
		<servlet-name>AdminItemView</servlet-name>
		<url-pattern>/admin/item-view</url-pattern>
	</servlet-mapping>
	
	<servlet>
    	<servlet-name>AdminOrders</servlet-name>
    	<servlet-class>com.music.servlets.AdminOrderServlet</servlet-class>
    </servlet>
    
	<servlet-mapping>
		<servlet-name>AdminOrders</servlet-name>
		<url-pattern>/admin/orders</url-pattern>
	</servlet-mapping>
	
	<servlet>
    	<servlet-name>AdminOrderView</servlet-name>
    	<servlet-class>com.music.servlets.AdminOrderViewServlet</servlet-class>
    </servlet>
    
	<servlet-mapping>
		<servlet-name>AdminOrderView</servlet-name>
		<url-pattern>/admin/order-view</url-pattern>
	</servlet-mapping>
	
    <servlet>
    	<servlet-name>Order</servlet-name>
    	<servlet-class>com.music.servlets.OrderSevlet</servlet-class>
    </servlet>
	
    <servlet-mapping>
    	<servlet-name>Order</servlet-name>
  		<url-pattern>/order/*</url-pattern>
    </servlet-mapping>
    
	<servlet>
    	<servlet-name>AdminDashboardView</servlet-name>
    	<servlet-class>com.music.servlets.AdiminDashboard</servlet-class>
    </servlet>
    
	<servlet-mapping>
		<servlet-name>AdminDashboardView</servlet-name>
		<url-pattern>/admin/dashboard</url-pattern>
	</servlet-mapping>
	
	<servlet>
    	<servlet-name>AdminLogin</servlet-name>
    	<servlet-class>com.music.servlets.AdminLoginServlet</servlet-class>
    </servlet>
    
	<servlet-mapping>
		<servlet-name>AdminLogin</servlet-name>
		<url-pattern>/admin/login</url-pattern>
	</servlet-mapping>
	
	<!-- pulindu -->
	<servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>com.music.servlets.pulindu.ShopKeeperloginServelt</servlet-class>
    </servlet>     
   
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/log</url-pattern> 
    </servlet-mapping>
    
    <servlet>
    <servlet-name>UpdateKeeper</servlet-name>
	<servlet-class>com.music.servlets.pulindu.UpdateKeeperServlet</servlet-class>
	</servlet>
	
	<servlet-mapping>
	<servlet-name>UpdateKeeper</servlet-name>
	<url-pattern>/stk/update</url-pattern>
	</servlet-mapping>
	
	<servlet>
	<servlet-name>DeleteKeeper</servlet-name>
	<servlet-class>com.music.servlets.pulindu.DeleteKeeperServlet</servlet-class>
	</servlet>
	
	<servlet-mapping>
		<servlet-name>DeleteKeeper</servlet-name>
		<url-pattern>/stk/delete</url-pattern>
	</servlet-mapping>
	<!-- pulindu end -->

	<!-- tharindu -->
	<servlet>
		<servlet-name>addProduct</servlet-name>
		<servlet-class>com.music.servlets.tharindu.servlet.addProduct</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>addProduct</servlet-name>
		<url-pattern>/addpro</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>DeleteCart</servlet-name>
		<servlet-class>com.music.servlets.tharindu.servlet.DeleteCart</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>DeleteCart</servlet-name>
		<url-pattern>/delcart</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>UpdateCart</servlet-name>
		<servlet-class>com.music.servlets.tharindu.servlet.UpdateCart</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>UpdateCart</servlet-name>
		<url-pattern>/upcart</url-pattern>
	</servlet-mapping>
	<!-- tharindu end -->
</web-app>